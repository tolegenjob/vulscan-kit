{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vulscan.local/schemas/internal-heartbeat.v1.json",
  "type": "object",
  "properties": {
    "attempt": {
      "type": "integer",
      "minimum": 1
    },
    "requestsSent": {
      "type": "integer",
      "minimum": 0
    },
    "endpointsDone": {
      "type": "integer",
      "minimum": 0
    }
  },
  "required": [
    "attempt",
    "requestsSent",
    "endpointsDone"
  ]
}
